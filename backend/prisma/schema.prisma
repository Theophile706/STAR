generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parcelle {
  id                       String   @id @default(uuid()) @db.Uuid
  label                    String
  coordinates              Json
  center_lat               Float
  center_lng               Float
  surface_ha               Float?
  culture_declared         String?
  culture_detected         String?
  ndvi_percentage          Float?
  confidence               Float?
  verdict                  String?
  details                  String?
  saison                   String?
  soil_type                String?
  risk_factors             Json?
  recommendations          String?
  data_source              String?
  owner_name               String?
  notes                    String?
  time_series_s1           Json?
  time_series_s2           Json?
  estimated_planting_date  String?
  estimated_harvest_date   String?
  days_since_planting     Int?
  growth_stage             String?
  planting_confidence      Float?
  evi                      Float?
  savi                     Float?
  ndwi                     Float?
  agro_score               Float?
  hybrid_score             Float?
  cnn_prob_barley          Float?
  cnn_prob_non_barley      Float?
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  @@map("parcelles")
}
